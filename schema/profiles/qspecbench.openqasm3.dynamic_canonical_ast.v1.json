{
  "id": "qspecbench.openqasm3.dynamic_canonical_ast.v1",
  "upstream_standard": "OpenQASM",
  "upstream_version": "3.0",
  "parser_implementation": "QSpecBench.Quantum.OpenQASM3Parser.parseQasmBytes/parseQasmSourceE",
  "parser_version": "qspecbench-openqasm-fragment-0.1",
  "include_policy": "skipped_not_interpreted",
  "accepted_headers": ["OPENQASM 3.0", "OPENQASM 3", "include"],
  "accepted_declarations": ["qubit", "qubit[]", "bit", "bit[]"],
  "gate_set": ["i", "x", "y", "z", "h", "s", "sdg", "t", "tdg", "cx", "ccx"],
  "angle_grammar": "none",
  "control_flow_support": "if_else_classical",
  "measurement_support": "projective_record",
  "reset_support": "allowed",
  "wire_order_convention": "legacy_kron_order",
  "global_phase_policy": "exact",
  "unsupported_syntax_behavior": "fail_closed",
  "notes": "Dynamic subset: mid-circuit measure, reset, if/else/nested, bounded for/while[N], classical bit[]. Include lines are skipped, not interpreted. Checked software ISA abstraction only. Unsupported/deeper syntax and hardware/device semantics remain outside scope; this is not full OpenQASM 3."
}
