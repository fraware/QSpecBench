{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qspecbench.org/schema/review_attestation_v2.schema.json",
  "title": "QSpecBench Review Attestation v2",
  "type": "object",
  "required": ["schema", "benchmark_id", "proposition_id", "reviewer", "role", "reviewed_commit", "reviewed_artifacts", "accepted_obligations", "residual_assumptions", "conflicts", "decision"],
  "properties": {
    "schema": {"const": "qspecbench.review_attestation.v2"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "proposition_id": {"type": "string", "minLength": 1},
    "reviewer": {
      "type": "object",
      "required": ["name", "github_login", "github_user_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "github_login": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
        "github_user_id": {"type": "integer", "minimum": 1},
        "orcid": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "role": {"type": "string", "enum": ["formal_evidence", "domain_semantics", "tooling_trust", "track_maintainer"]},
    "reviewed_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "public_review": {
      "type": "object",
      "properties": {
        "pull_request": {"type": ["integer", "null"], "minimum": 1},
        "review_id": {"type": ["integer", "null"], "minimum": 1},
        "url": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": false
    },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "accepted_obligations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rejected_obligations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "residual_assumptions": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "decision": {"type": "string", "enum": ["approved", "rejected", "changes_requested"]},
    "attestation": {
      "type": "object",
      "properties": {
        "method": {"type": "string", "enum": ["github_review", "sigstore", "signed_commit", "other"]},
        "reference": {"type": "string", "minLength": 1}
      },
      "required": ["method", "reference"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
