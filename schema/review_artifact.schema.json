{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qspecbench.org/schema/review_artifact.schema.json",
  "title": "QSpecBench review artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "commit_sha",
    "reviewer",
    "reviewer_role",
    "reviewed_artifacts",
    "commands_executed",
    "accepted_obligations",
    "rejected_obligations",
    "residual_assumptions",
    "conflict_of_interest",
    "decision",
    "signature"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "commit_sha": {
      "type": "string",
      "minLength": 7,
      "pattern": "^[a-f0-9]+$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "enum": ["formal_evidence", "domain_semantics"]
    },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands_executed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "accepted_obligations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rejected_obligations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "residual_assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflict_of_interest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_author", "is_merging_maintainer"],
      "properties": {
        "is_author": { "type": "boolean" },
        "is_merging_maintainer": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "pending"]
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque signature token or unsigned-corpus marker; cryptographic binding optional in v0.3"
    },
    "proposition_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
