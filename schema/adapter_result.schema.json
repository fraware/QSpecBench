{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qspecbench.org/schema/adapter_result.schema.json",
  "title": "QSpecBench Adapter Result",
  "type": "object",
  "required": ["schema", "adapter_id", "adapter_version", "benchmark_id", "proposition_id", "semantic_profile_id", "status", "supported_obligations", "trust_class", "input_hashes"],
  "properties": {
    "schema": {"const": "qspecbench.adapter_result.v1"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "adapter_version": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "proposition_id": {"type": "string", "minLength": 1},
    "semantic_profile_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["passing", "failing", "partial", "not_checked"]},
    "supported_obligations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trust_class": {"type": "string", "enum": ["kernel_checked", "proof_assistant_native_checked", "independently_checkable", "externally_trusted", "simulation", "human_review", "heuristic", "untrusted"]},
    "semantic_profile_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "semantic_profile_version": {"type": ["string", "null"]},
    "tool": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "input_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "runner_execution": {
      "type": "object",
      "required": ["wall_time_seconds", "timed_out", "exit_code", "limits"],
      "properties": {
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "timed_out": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]},
        "limits": {
          "type": "object",
          "properties": {
            "timeout_seconds": {
              "$ref": "#/$defs/limitObservation"
            },
            "memory_mb": {
              "$ref": "#/$defs/limitObservation"
            },
            "cpu_seconds": {
              "$ref": "#/$defs/limitObservation"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "certificate_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "limitObservation": {
      "type": "object",
      "required": ["requested", "status"],
      "properties": {
        "requested": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["enforced", "attempted", "unavailable", "not_requested"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
